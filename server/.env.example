# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"

# --- PayPal (sandbox only) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox -> SpendSage
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# INR is unreliable for Checkout on an Indian merchant account, so the vault runs in USD.
PAYPAL_CURRENCY=USD

# --- AI ---
# aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
